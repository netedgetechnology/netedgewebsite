Options -Indexes

RewriteEngine On

# Standalone CMS routes - must be before front controller
RewriteRule ^cms/?$ public/cms.php [L,QSA]
RewriteRule ^cms/login/?$ public/cms.php [L,QSA]
RewriteRule ^cms/logout/?$ public/cms.php [L,QSA]



# ------------------------------------------------------------
# Security: block direct access to non-public application files
# ------------------------------------------------------------
RewriteRule ^(app|storage|database)(/|$) - [F,L]
RewriteRule ^(INSTALLATION|SECURITY-CHECKLIST|PAGES_UPDATED|CMS_CREDENTIALS|CMA_CREDENTIALS).* - [F,L]
RewriteRule \.(md|env|ini|log|sql|bak|old|zip)$ - [F,L]

# ------------------------------------------------------------
# Serve public assets/files without exposing /public in URL
# Example: /assets/css/style.css -> /public/assets/css/style.css
# ------------------------------------------------------------
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
RewriteRule ^(.+)$ public/$1 [L]

# ------------------------------------------------------------
# Route everything else to root bridge index.php
# ------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
