.widget {
  margin: 0 auto 30px;
  padding: 0;
}
.widget .widgettitle {
  position: relative;
  overflow: hidden;
  margin: 0px;
  padding: 0px 0px 10px 0px;
}
.widget .widgettitle,
.widget .widgettitle a {
  word-wrap: break-word;
}
.widget .widgettitle a {
  color: inherit;
}
.widget .widgettitle > .icon {
  margin-right: 10px;
  vertical-align: baseline;
}
.widget:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: 0;
  background: transparent;
}
.widget.widget_recent_entries a {
  display: inline;
}
.widget.widget_recent_entries .post-date {
  display: block;
  padding-top: 5px;
}
.widget.widget_recent_comments li {
  padding: 15px 0;
}
.widget.widget_recent_comments li > a {
  display: block !important;
}
.widget ul,
.widget ol {
  margin: 0;
  padding: 0;
  list-style: none;
}
.widget li {
  position: relative;
  overflow: hidden;
  margin: 0;
  padding: 0.6em 0;
  transition: all 0.2s ease;
  text-overflow: ellipsis;
  word-wrap: break-word;
}
.widget li:not(:last-child) {
  border-bottom: dotted 1px var(--vamtam-default-line-color);
}
.widget li .count {
  color: var(--vamtam-accent-color-3);
  font-size: calc(var(--vamtam-primary-font-font-size) - 2px);
}
.widget select {
  max-width: 100%;
}
.widget .lang_sel_click li {
  overflow: visible;
}
/* Widgets in sidebars ------------------------------------------------------ */
.widget-box:after {
  position: relative;
  top: 10px;
  display: block;
  clear: both;
  margin: 0 -10px;
  height: 1px;
  content: "";
}
.vamtam-body-sidebar .widget {
  margin: 0 0px 40px 0px;
  padding: 0;
}
.vamtam-body-sidebar .widget .widgettitle {
  background: transparent;
  border-bottom: solid 1px var(--vamtam-default-line-color);
  padding-bottom: 10px;
  margin-bottom: 20px;
}
.vamtam-body-sidebar .widget .widgettitle > .icon {
  margin-top: -3px;
}
.vamtam-body-sidebar .widget .widgettitle > .icon.shortcode {
  color: var(--vamtam-accent-color-7);
}
.vamtam-body-sidebar .widget .widgettitle + ul,
.vamtam-body-sidebar .widget .widgettitle + ol,
.vamtam-body-sidebar .widget .widgettitle + div,
.vamtam-body-sidebar .widget .widgettitle + form {
  border: none;
}
.vamtam-body-sidebar .widget ul.children {
  border-top: dotted 1px var(--vamtam-default-line-color);
  margin-top: 10px;
  margin-bottom: -10px;
  margin-left: 10px;
}
.vamtam-body-sidebar .widget ul.children li:last-child {
  border-bottom: none;
}
.vamtam-body-sidebar .widget > ul:after,
.vamtam-body-sidebar .widget > ol:after,
.vamtam-body-sidebar .widget > div:after,
.vamtam-body-sidebar .widget > h4 + form:after {
  position: relative;
  top: 10px;
  display: block;
  clear: both;
  margin: 0 -10px;
  height: 1px;
  content: "";
}
.vamtam-body-sidebar .widget .tagcloud {
  margin-top: 10px;
}
/* Widgets in footer -------------------------------------------------------- */
#main-footer .widget .widgettitle {
  white-space: normal;
}
#page.disable-hover,
.main-container.disable-hover {
  pointer-events: none;
}
