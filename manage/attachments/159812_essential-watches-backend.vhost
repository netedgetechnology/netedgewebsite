server {
    listen 80;
    root  /home/essentialwatches/httpdocs/EW_Backend;
    server_name admin.essentialwatches.com essentialwatches.com;
    index  index.php;
    proxy_read_timeout            600;
    proxy_send_timeout            600;
    fastcgi_read_timeout	  600;


    location ~* \.php$ {
        fastcgi_index   index.php;
        include         fastcgi_params;
        fastcgi_param   SCRIPT_FILENAME    $document_root$fastcgi_script_name;
        fastcgi_param   SCRIPT_NAME        $fastcgi_script_name;
        fastcgi_temp_file_write_size 100m;
        fastcgi_busy_buffers_size    64k;
        fastcgi_buffer_size          64k;
        fastcgi_buffers           16 64k;         
	fastcgi_read_timeout 172800;
#        fastcgi_pass 127.0.0.1:9001;
        fastcgi_pass unix:/var/run/php5-fpm.sock;
   }
            # deny access to .htaccess files, if Apache's document root
            # concurs with nginx's one
            #
            location ~ /\.ht {
                    deny all;
            }


    location ~* \.(js|css|png|jpg|jpeg|gif|ico)(\?ver=[0-9.]+)?$ { expires 1y; }
    location ~* \.(jpg|png|gif|jpeg|css|js)$ {expires 50h;}
}
