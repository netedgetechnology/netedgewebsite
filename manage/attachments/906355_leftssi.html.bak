    function emailCheckFLE1(){
		if($('#email_fld').val()==''){
		    alert("Please enter your email address.");
		    $('#email_fld').focus();
		    return false;
		}
		if($('#fname_fld').val()==''){
		    alert("Please enter your first name.");
		    $('#fname_fld').focus();
		     return false;
		}
		if($('#dogname_fld').val()==''){
		    alert("Please enter your dog name.");
		    $('#dogname_fld').focus();
		     return false;
		}
	    }
    var d = new Date();
    var curr_date = d.getDate();
    var curr_month = d.getMonth() + 1; //Months are zero based
    var curr_year = d.getFullYear();
    var hr=d.getHours();
    var mins=d.getMinutes();
    var sec=d.getSeconds();

    var sign_date = curr_year+"-"+curr_month+"-"+curr_date+"  "+hr+":"+mins+":"+sec;
    $('#sign_date').val(sign_date);
 </script>	
